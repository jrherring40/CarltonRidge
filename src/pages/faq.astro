---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'HOW MANY GUESTS CAN CARLTON RIDGE ACCOMMODATE?',
    a: "The villa comfortably sleeps up to 12 guests across the six-bedroom suites. The main house has four double suites, and the garden residence has two double suites. The main house can be booked separately for up to 8 guests, if you don't need the full property.",
  },
  {
    q: "WHAT'S INCLUDED IN THE VILLA?",
    a: 'Your stay includes the full estate, all six bedrooms, and use of all amenities, with a chef’s kitchen (double oven, ample counter space), air conditioning throughout, ceiling fans, a private pool with wet bar and gazebo, a games room with pool table, and full irrigation and manicured gardens. Bedrooms are all en suite with air-conditioning; the two-bedroom garden residence has its own full kitchen, living area and shared patio.',
  },
  {
    q: 'IS THE GARDEN RESIDENCE SEPARATE FROM THE MAIN HOUSE?',
    a: "Yes. It's a fully self-contained two-bedroom annex with its own front door, dedicated parking, kitchen, living space and shared patio (accessed via the common living room, not directly from the bedrooms). It's ideal for grandparents, older children, or a second family group who'd like their own space.",
  },
  {
    q: 'IS STAFF OR CONCIERGE SERVICE INCLUDED?',
    a: 'Regular housekeeping is included in your stay. The Island Villas team offers a dedicated five-star concierge service, which can arrange for private chefs, airport fast-track, drivers and in-villa experiences.',
  },
  {
    q: 'IS THE VILLA SUITABLE FOR FAMILIES WITH CHILDREN?',
    a: "The layout — four bedrooms in the main house plus a separate two-bedroom garden residence — suits multigenerational or family groups well, giving older children or grandparents their own space. Specific child-safety features such as pool fencing, cots or high chairs can be arranged directly through Island Villas if travelling with young children.",
  },
  {
    q: 'IS CARLTON RIDGE CLOSE TO THE BEACH?',
    a: 'Yes — the villa is 700 metres from Thunder Bay beach, and within easy reach of the Platinum Coast beaches near to Holetown and Speightstown such as Alleynes Bay, Mullins Beach and Heywoods Beach.',
  },
  {
    q: 'WHAT ARE THE RATES, AND DO THEY VARY BY SEASON?',
    a: 'Yes, rates are seasonal. As a guide, per night for the full six-bedroom villa: Christmas US$2,500, Winter US$1,700, Summer US$1,200. The four-bedroom main house alone is also available at a lower nightly rate across the same seasons — see the full price table on our <a href="/reserve">Reserve page</a>. All rates are subject to a 10% Shared Economy Levy and a 2.5% Service Fee.',
  },
  {
    q: 'HOW DO I CHECK AVAILABILITY OR MAKE A BOOKING?',
    a: 'Carlton Ridge is managed by Island Villas. You can check live availability and enquire directly through <a href="https://www.island-villas.com/properties/21809035/lettings/carlton-ridge/CARLTONRIDGE#/" target="_blank" rel="noopener noreferrer">their listing</a>, or call their Barbados team on +1 (246) 422-3333.',
  },
  {
    q: 'WHAT IS THE MINIMUM STAY?',
    a: 'We require a minimum of five nights. Holiday periods may have extended minimum stay requirements - please check with Island Villas, our managing agent — at <a href="https://www.island-villas.com/properties/21809035/lettings/carlton-ridge/CARLTONRIDGE#/" target="_blank" rel="noopener noreferrer">their listing</a>.',
  },
  {
    q: 'IS THERE A SECURITY DEPOSIT?',
    a: "Yes. A security deposit is required at the time of booking of US$750.",
  },
  {
    q: 'IS THERE PARKING ON SITE?',
    a: 'There is ample parking. In addition to the double garage, the driveway extends the full length of the property, enabling the garden residence to be easily accessible without having to come through the main house or pool area.',
  },
  {
    q: 'IS WI-FI AVAILABLE?',
    a: 'Gigabit Wi-Fi is available throughout the property and gardens.',
  },
  {
    q: 'IS THERE AIR CONDITIONING THROUGHOUT?',
    a: 'Yes — air conditioning is fitted in every bedroom, and the kitchen and living room of the main house. Ceiling fans are fitted in all areas of the main house and garden residence, including bathrooms and walk-in wardrobes, and the outdoor poolside wet bar.',
  },
  {
    q: 'WHAT SECURITY FEATURES DOES THE PROPERTY HAVE?',
    a: 'The property has electronic gates, an alarm system, security cameras, a monitored security system and a safe in every bedroom.',
  },
  {
    q: 'HOW FAR IS CARLTON RIDGE FROM THE AIRPORT?',
    a: 'The villa is located in Carlton View Estate, Holetown, St. James, on the West Coast — approximately a 40-minute drive from Grantley Adams International Airport. Precise directions will be provided by Island Villas prior to arrival.',
  },
  {
    q: 'IS THERE A CANCELLATION POLICY?',
    a: 'Yes. Cancellation policy varies by season. Check <a href="https://www.island-villas.com/deposit-payment-and-cancellation-policy#/" target="_blank" rel="noopener noreferrer">here</a> for details.',
  },
  {
    q: "WHAT HAPPENS IF THERE'S A POWER OR WATER OUTAGE?",
    a: 'The property has a large backup generator capable of powering the whole house, plus two 1,000-gallon water tanks and a water softener, so guests are well covered during any utilities disruption.',
  },
  {
    q: "DON'T SEE YOUR QUESTION HERE?",
    a: 'Get in touch via our <a href="https://www.island-villas.com/contact" target="_blank" rel="noopener noreferrer">Contact Us</a> page and we’ll get back to you directly.',
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---
<BaseLayout title="FAQ" description="Frequently asked questions about staying at Carlton Ridge, Barbados.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="page-hero">
    <div class="wrap page-hero__content">
      <p class="eyebrow">Good to know</p>
      <h1>Frequently Asked Questions</h1>
      <p>A few common questions about staying at Carlton Ridge.</p>
    </div>
  </section>

  <section class="section section-sand">
    <div class="wrap faq-list">
      {faqs.map(f => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p set:html={f.a} />
        </details>
      ))}
    </div>
  </section>

  <section class="section cta-band">
    <div class="wrap cta-band__inner">
      <h2>Still have a question?</h2>
      <a href="https://www.island-villas.com/branches/barbados" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark">Contact Us</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--navy); padding: 6rem 0 3rem; color: var(--white); }
  .page-hero__content h1 { color: var(--white); }
  .page-hero__content p { color: var(--duck-egg-pale); margin-top: 0.6rem; }

  .faq-list { max-width: 780px; display: flex; flex-direction: column; gap: 0.9rem; }
  .faq-item { background: var(--duck-egg-pale); padding: 1.4rem 1.8rem; }
  .faq-item summary { cursor: pointer; font-weight: 600; color: var(--navy); font-size: 1.02rem; list-style: none; position: relative; padding-right: 1.6rem; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 0;
    font-size: 1.2rem;
    color: var(--gold);
  }
  .faq-item[open] summary::after { content: '\2212'; }
  .faq-item p { color: var(--navy-soft); margin-top: 1rem; font-size: 0.95rem; line-height: 1.6; }
  .faq-item p a { color: var(--gold); text-decoration: underline; }
</style>
