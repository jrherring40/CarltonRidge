---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="page-hero">
    <div class="wrap page-hero__content">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p>The page you were looking for doesn&rsquo;t exist or has moved.</p>
      <p><a href="/" class="btn btn-gold">Back to home</a></p>
    </div>
  </section>
</BaseLayout>
