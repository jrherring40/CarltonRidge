---
import BaseLayout from '../layouts/BaseLayout.astro';

const ISLAND_VILLAS_URL = 'https://www.island-villas.com/properties/21809035/lettings/carlton-ridge/CARLTONRIDGE#/availability';
const PHONE_DISPLAY = '+1 (246) 422-3333';
const PHONE_TEL = 'tel:+12464223333';

const rates = [
  { season: 'Christmas', six: '2,500', four: '1,667' },
  { season: 'Winter', six: '1,700', four: '1,134' },
  { season: 'Summer', six: '1,200', four: '800' },
];
---
<BaseLayout title="Reserve" description="Rates and availability for staying at Carlton Ridge, Barbados.">
  <section class="page-hero">
    <div class="wrap page-hero__content">
      <p class="eyebrow">Get in touch</p>
      <h1>Rates &amp; Availability</h1>
      <p>Villa rentals at Carlton Ridge are managed by Island Villas &mdash; check availability and reserve through their team below.</p>
    </div>
  </section>

  <section class="section section-sand reserve">
    <div class="wrap reserve__grid">
      <div class="rates">
        <p class="eyebrow">Price table</p>
        <h2>Rates</h2>
        <div class="divider"></div>
        <p class="rates-intro">The villa comfortably sleeps up to 12 guests across the six double bedroom suites. The main house has four suites, and the garden residence has two suites. The main house can be booked separately for up to 8 guests, if you don&rsquo;t need the full property.</p>
        <div class="rates-table-wrap">
          <table class="rates-table">
            <thead>
              <tr>
                <th scope="col"></th>
                <th scope="col"><span class="rates-table__head">6 bedrooms &middot; up to 12 guests</span><span class="rates-table__unit">Per night (US$)</span></th>
                <th scope="col"><span class="rates-table__head">4 bedrooms &middot; up to 8 guests</span><span class="rates-table__unit">Per night (US$)</span></th>
              </tr>
            </thead>
            <tbody>
              {rates.map(r => (
                <tr>
                  <th scope="row">{r.season}</th>
                  <td>{r.six}</td>
                  <td>{r.four}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="rates-note">Rates are per night in US dollars. A 10% Shared Economy Levy and 2.5% Service Fee are added.</p>

        <div class="next-steps">
          <p class="eyebrow">What happens next?</p>
          <h3>Ready to check your dates?</h3>
          <ol class="next-steps__list">
            <li>Check availability with Island Villas</li>
            <li>Choose your dates and party size</li>
            <li>Secure your stay with the Barbados-based team</li>
            <li>Arrive and settle in &mdash; with help arranging transfers, chefs and experiences if you need them</li>
          </ol>
        </div>
      </div>

      <div class="managed-by">
        <p class="eyebrow">Bookings &amp; availability</p>
        <h2>Your week at Carlton Ridge starts here</h2>
        <div class="divider"></div>
        <p>Carlton Ridge is available as the full six-bedroom residence for up to 12 guests, or as the four-bedroom main house for smaller groups.</p>
        <p>Choose your dates below to see current availability and rates. Bookings are handled by our Barbados-based rental team at Island Villas.</p>
        <div class="managed-by__actions">
          <a href={ISLAND_VILLAS_URL} class="btn btn-gold" target="_blank" rel="noreferrer">Check Availability</a>
          <a href={PHONE_TEL} class="btn btn-outline-dark">Call {PHONE_DISPLAY}</a>
        </div>
        <p class="managed-by__extra">The team can also help arrange airport transfers, chefs, drivers and experiences during your stay.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--navy); padding: 6rem 0 3.5rem; color: var(--white); }
  .page-hero__content h1 { color: var(--white); margin-top: 0.6rem; }
  .page-hero__content p { color: var(--duck-egg-pale); margin-top: 0.6rem; max-width: 560px; }

  /* Shared top inset so the Rates column lines up with the padded availability card */
  .reserve { --card-pad: 2.6rem; }
  /* Rates take the remaining space; the availability card sizes itself to its one-line heading */
  .reserve__grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 3.5rem; align-items: start; }
  .rates { padding-top: var(--card-pad); }

  .rates-intro { color: var(--navy-soft); font-size: 1.02rem; line-height: 1.65; margin: 0; }
  .rates-table-wrap { margin-top: 2rem; overflow-x: auto; }
  .rates-table { width: 100%; border-collapse: collapse; min-width: 420px; }
  .rates-table th, .rates-table td { padding: 1rem 1.2rem; text-align: left; border-bottom: 1px solid rgba(22,38,58,0.12); }
  .rates-table thead th { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--navy-soft); font-weight: 600; }
  .rates-table__head, .rates-table__unit { display: block; }
  .rates-table__unit { margin-top: 0.3rem; color: var(--navy); letter-spacing: 0.06em; }
  .rates-table tbody th { font-weight: 600; color: var(--navy); }
  .rates-table tbody td { color: var(--navy-soft); }
  .rates-table tbody tr:hover { background: var(--duck-egg-pale); }
  .rates-note { margin-top: 1.2rem; font-size: 0.9rem; color: var(--navy-soft); }

  .managed-by {
    background: var(--white);
    padding: var(--card-pad);
    width: 460px;
  }
  .managed-by p { color: var(--navy-soft); }
  .managed-by p + p { margin-top: 1rem; }
  .managed-by .managed-by__extra { margin-top: 1.4rem; }
  .managed-by__actions { display: flex; flex-direction: column; gap: 1rem; margin-top: 1.6rem; }
  .managed-by__actions .btn { width: 100%; min-height: 3.4rem; white-space: nowrap; box-sizing: border-box; text-align: center; justify-content: center; }

  .next-steps { margin-top: 3rem; }
  .next-steps h3 { margin-top: 0.4rem; }
  .next-steps__list { margin: 1.5rem 0 0; padding-left: 1.4rem; color: var(--navy-soft); line-height: 1.65; }
  .next-steps__list li { padding-left: 0.4rem; margin-bottom: 0.6rem; }
  .next-steps__list li::marker { color: var(--navy); font-weight: 600; }

  @media (max-width: 1100px) {
    .reserve__grid { grid-template-columns: 1fr; gap: 3rem; }
    .rates { padding-top: 0; }
    .managed-by { width: auto; }
  }
  @media (max-width: 560px) {
    .reserve { --card-pad: 1.6rem; }
    .rates-table { min-width: 0; }
    .rates-table th, .rates-table td { padding: 0.8rem 0.6rem; }
    .rates-table thead th { font-size: 0.66rem; letter-spacing: 0.06em; line-height: 1.4; vertical-align: bottom; }
    .managed-by__actions .btn { padding-left: 1em; padding-right: 1em; letter-spacing: 0.1em; }
  }
</style>
