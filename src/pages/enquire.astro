---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryForm from '../components/EnquiryForm.jsx';
---
<BaseLayout title="Enquire" description="Check availability and enquire about staying at Carlton Ridge, Barbados.">
  <section class="page-hero">
    <div class="wrap page-hero__content">
      <p class="eyebrow">Get In Touch</p>
      <h1>Enquire</h1>
      <p>Tell us your dates and party size, and we’ll come back to you directly &mdash; no booking platform, no middleman.</p>
    </div>
  </section>

  <section class="section section-sand enquire">
    <div class="wrap enquire__grid">
      <div class="enquire__form">
        <EnquiryForm client:load />
      </div>
      <aside class="enquire__aside">
        <p class="eyebrow">Direct Contact</p>
        <h3>Prefer to reach us directly?</h3>
        <div class="divider"></div>
        <p><a href="mailto:stay@carltonridgevilla.com">stay@carltonridgevilla.com</a></p>
        <p><a href="https://wa.me/12460000000">WhatsApp +1 246 000 0000</a></p>
        <p class="enquire__note">Rates vary by season and party size &mdash; send your dates and we’ll reply with availability and pricing.</p>
        <div class="enquire__addr">
          <p class="eyebrow">Address</p>
          <p>Carlton View Estate, Holetown<br />St. James, Barbados, West Indies</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--navy); padding: 6rem 0 3.5rem; color: var(--white); }
  .page-hero__content p { color: var(--duck-egg-pale); margin-top: 0.6rem; max-width: 560px; }

  .enquire__grid { display: grid; grid-template-columns: 1.4fr 0.9fr; gap: 4rem; align-items: start; }
  .enquire__aside {
    background: var(--duck-egg-pale);
    padding: 2.4rem;
  }
  .enquire__aside p { color: var(--navy-soft); }
  .enquire__aside a { color: var(--navy); font-weight: 500; }
  .enquire__note { font-size: 0.88rem; margin-top: 1rem; }
  .enquire__addr { margin-top: 2rem; padding-top: 1.6rem; border-top: 1px solid var(--duck-egg-dark); }

  @media (max-width: 900px) {
    .enquire__grid { grid-template-columns: 1fr; }
  }
</style>
