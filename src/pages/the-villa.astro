---
import BaseLayout from '../layouts/BaseLayout.astro';

const houseFeatures = [
  { title: 'Kitchen', img: '/images/Kitchen.jpeg', copy: 'A double oven and a run of counter space built for real cooking, opening directly onto the covered dining patio so nothing gets cold, or lonely, on the way to the table.' },
  { title: 'Living Room', img: '/images/LivingRoom.jpeg', copy: 'High ceilings and cross-breezes from ceiling fans throughout, with the living area folding out onto a covered terrace for indoor-outdoor evenings.' },
  { title: 'Games Room', img: '/images/PoolTable.jpeg', copy: 'A games room just off the terrace, with a full-size pool table and board games for slower evenings.' },
];

const mainBedrooms = [
  { title: 'Master Suite', img: '/images/mastersuite2.png', copy: 'Wake to garden and pool views in the main master suite, which opens directly onto a covered veranda. It has its own TV and seating area and a walk-in dressing room with make-up table, making this the villa’s most private and spacious bedroom.' },
  { title: 'Master Bathroom', img: '/images/MasterBathroom.jpeg', copy: 'A generous en-suite designed for unwinding, featuring his-and-hers vanities, a deep bath and an enclosed steam shower. After a day by the pool or exploring the island, it’s a lovely place to slow down and recharge with robes and slippers, local toiletries from <a href="https://stlucybotanists.com" target="_blank" rel="noopener noreferrer">St Lucy Botanists</a> included.' },
];

const otherBedrooms = [
  { title: 'Poolside Guest Suite', img: '/images/masterguestpool.png', copy: 'A guest bedroom with an en-suite bathroom, fitted wardrobes and double doors opening onto a private patio, overlooking the pool and gardens.' },
  { title: 'Garden Guest Suite', img: '/images/villaguestroom3.png', copy: 'A guest bedroom with an en-suite bathroom, walk-in wardrobe and double doors opening onto a private patio, tucked among the villa’s tropical gardens.' },
  { title: 'Garden Guest Suite', img: '/images/blushpinkroom.png', copy: 'A guest bedroom with an en-suite bathroom, walk-in wardrobe and double doors opening onto a private patio, tucked among the villa’s tropical gardens.' },
];

const gardenResidencePhotos = [
  { title: 'Living Room', img: '/images/CottageLivingRoom.jpeg', copy: 'Self-contained living space with its own full kitchen.' },
  { title: 'Patio', img: '/images/CottageTerrace.jpeg', copy: 'A patio with a path through the gardens to the pool.' },
  { title: 'Garden Residence Suite One', img: '/images/gardenresidenceleftbedroom.png', copy: 'An air-conditioned en-suite bedroom with a full-size bed (UK king-equivalent) and walk-in wardrobe.' },
  { title: 'Garden Residence Suite Two', img: '/images/gardenresidencerightbedroom.png', copy: 'A second en-suite bedroom, with the same independent comfort and garden setting.' },
];
---
<BaseLayout title="The Villa" description="A room-by-room look at Carlton Ridge's main house and grounds.">
  <section class="page-hero">
    <img src="/images/LivingRoom.jpeg" alt="Interior of the main living room at Carlton Ridge" class="page-hero__img" fetchpriority="high" decoding="async" />
    <div class="page-hero__scrim"></div>
    <div class="wrap page-hero__content">
      <p class="eyebrow eyebrow--light">The property</p>
      <h1>THE VILLA</h1>
      <p>Carlton Ridge pairs the easy rhythm of island living with the space to spread out across six thousand square feet, arranged across the main house and separate, private garden residence.</p>
    </div>
  </section>

  <section class="section section-duckegg at-a-glance">
    <div class="wrap">
      <p class="eyebrow">At a glance</p>
      <p class="at-a-glance__line">6 bedrooms &middot; 12 guests &middot; 4-bedroom main house &middot; 2-bedroom garden residence</p>
    </div>
  </section>

  <section class="section section-sand">
    <div class="wrap">
      <p class="eyebrow">Living spaces</p>
      <h2>Living spaces built around light and breeze</h2>
      <div class="divider"></div>
      <p class="lede">The main house holds four en-suite bedrooms around a central living and dining space that opens fully to the garden. Nothing here is closed off &mdash; the kitchen sees the dining table, the living room sees the terrace, the terrace sees the pool.</p>
    </div>
    <div class="wrap feature-grid">
      {houseFeatures.map(f => (
        <div class="feature-card">
          <img src={f.img} alt={f.title} loading="lazy" decoding="async" />
          <h3>{f.title}</h3>
          <p set:html={f.copy} />
        </div>
      ))}
    </div>
  </section>

  <section class="section section-duckegg">
    <div class="wrap">
      <p class="eyebrow">The bedrooms</p>
      <h2>Four bedrooms, each built for rest</h2>
      <div class="divider"></div>
      <p class="lede">Four en-suite bedrooms spread across the main house, each with its own character and views over the gardens or pool.</p>
    </div>
    <div class="wrap bedroom-grid bedroom-grid--two">
      {mainBedrooms.map(b => (
        <div class="feature-card">
          <img src={b.img} alt={b.title} loading="lazy" decoding="async" />
          <h3>{b.title}</h3>
          <p set:html={b.copy} />
        </div>
      ))}
    </div>
    <div class="wrap bedroom-grid bedroom-grid--three">
      {otherBedrooms.map(b => (
        <div class="feature-card">
          <img src={b.img} alt={b.title} loading="lazy" decoding="async" />
          <h3>{b.title}</h3>
          <p set:html={b.copy} />
        </div>
      ))}
    </div>
  </section>

  <section class="section section-sand cottage-teaser">
    <div class="wrap">
      <p class="eyebrow">Also on the estate</p>
      <h2>The Garden Residence</h2>
      <p class="cottage-teaser__copy">A private, self-contained two-bedroom retreat with its own entrance and parking &mdash; ideal for family or guests who want a little more independence.</p>
    </div>
    <div class="wrap cottage-teaser__grid">
      {gardenResidencePhotos.map(p => (
        <div class="cottage-teaser__photo">
          <img src={p.img} alt={p.title} loading="lazy" decoding="async" />
          <h3>{p.title}</h3>
          <p>{p.copy}</p>
        </div>
      ))}
    </div>
    <div class="wrap cottage-teaser__cta">
      <a href="/garden-residence" class="btn btn-outline-dark">Explore the Garden Residence</a>
    </div>
  </section>

  <section class="section section-duckegg grounds">
    <div class="wrap grounds__grid">
      <div class="grounds__images">
        <img src="/images/Pool.png" alt="Heptagonal swimming pool at Carlton Ridge" loading="lazy" decoding="async" />
        <img src="/images/patio.png" alt="Covered outdoor patio at Carlton Ridge" loading="lazy" decoding="async" />
        <img src="/images/OutdoorBar.webp" alt="Outdoor wet bar at Carlton Ridge" class="img--auto" />
      </div>
      <div class="grounds__text">
        <p class="eyebrow">The grounds</p>
        <h2>Gardens, pool &amp; a wet bar built for long afternoons</h2>
        <div class="divider"></div>
        <p>The outdoor deck and pool sit within manicured gardens dense with flowering trees, framed by a gazebo and wet bar built for entertaining.</p>
        <ul class="grounds__list">
          <li>Private heptagonal pool with sun deck</li>
          <li>Gazebo &amp; outdoor wet bar</li>
          <li>Covered dining patio</li>
          <li>Games room with pool table</li>
          <li>Whole-property backup generator</li>
          <li>Two 1,000-gallon water tanks &amp; softener</li>
          <li>Full irrigation system</li>
          <li>Electronic gates &amp; alarm system</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-duckegg cta-band">
    <div class="wrap cta-band__inner">
      <h2>See every room in the full gallery</h2>
      <a href="/gallery" class="btn btn-outline-dark">View Gallery</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { position: relative; height: 52vh; min-height: 380px; display: flex; align-items: flex-end; color: var(--white); }
  .page-hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .page-hero__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(22,38,58,0.45), rgba(22,38,58,0.8)); }
  .page-hero__content { position: relative; padding-bottom: 3rem; max-width: 640px; }
  .page-hero__content h1 { color: var(--white); }
  .page-hero__content p { color: var(--duck-egg-pale); margin-top: 0.6rem; }
  .eyebrow--light { color: var(--white); }
  .eyebrow--light::before { background: var(--duck-egg); }

  .lede { max-width: 680px; color: var(--navy-soft); font-size: 1.05rem; }

  .at-a-glance { padding-top: 1.8rem; padding-bottom: 1.8rem; }
  .at-a-glance__line { text-align: center; font-size: 1.05rem; color: var(--navy-soft); letter-spacing: 0.02em; }

  .feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.6rem; margin-top: 3rem; }
  .feature-card img { width: 100%; height: 200px; object-fit: cover; margin-bottom: 1rem; }
  .feature-card p { font-size: 0.9rem; color: var(--navy-soft); }

  .bedroom-grid { display: grid; gap: 1.6rem; margin-top: 3rem; }
  .bedroom-grid--two { grid-template-columns: repeat(2, 1fr); }
  .bedroom-grid--three { grid-template-columns: repeat(3, 1fr); margin-top: 1.6rem; }

  .cottage-teaser__copy { color: var(--navy-soft); margin-top: 0.4rem; max-width: 480px; }
  .cottage-teaser__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.6rem; margin-top: 2.5rem; }
  .cottage-teaser__photo img { width: 100%; height: 200px; object-fit: cover; margin-bottom: 0.8rem; }
  .cottage-teaser__photo p { font-size: 0.9rem; color: var(--navy-soft); }
  .cottage-teaser__cta { margin-top: 2.5rem; }

  .grounds__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: start; }
  .grounds__text p { color: var(--navy-soft); }
  .grounds__images { display: grid; gap: 1.2rem; }
  .grounds__images img { width: 100%; height: 280px; object-fit: cover; }
  .grounds__images img.img--auto { height: auto; object-fit: contain; }
  .grounds__list { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem 2rem; }
  .grounds__list li { position: relative; padding-left: 1.5em; font-size: 0.92rem; color: var(--navy-soft); }
  .grounds__list li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 7px; height: 7px; border: 1px solid var(--gold); transform: rotate(45deg); }

  @media (max-width: 900px) {
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
    .bedroom-grid--two, .bedroom-grid--three { grid-template-columns: repeat(2, 1fr); }
    .cottage-teaser__grid { grid-template-columns: repeat(2, 1fr); }
    .grounds__grid { grid-template-columns: 1fr; }
    .grounds__grid .grounds__images { order: 2; }
  }
</style>
