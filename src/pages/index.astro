---
import BaseLayout from '../layouts/BaseLayout.astro';

const heroFacts = '6 bedrooms · 8 bathrooms · Sleeps 12 · 6,000 sq ft';

const outdoorLiving = [
  'Private swimming pool with wet bar',
  'Covered terrace for lunches and sunset drinks',
  'Generous tropical gardens',
  'Chef’s kitchen with double oven',
  'Air conditioning throughout',
  'Six en-suite bedrooms',
];
---
<BaseLayout title="Carlton Ridge - A Private Barbados Residence on the West Coast">
  <!-- 1. HERO -->
  <section class="hero">
    <img src="/images/ArialSeaview.jpeg" alt="Aerial view of Carlton Ridge and the Barbados coastline" class="hero__img" fetchpriority="high" decoding="async" />
    <div class="hero__scrim"></div>
    <div class="wrap hero__content">
      <p class="eyebrow eyebrow--light">Private Barbados Residence &middot; West Coast</p>
      <h1>Carlton Ridge</h1>
      <p class="hero__headline">Your own private residence in Barbados</p>
      <p class="hero__lede">Six bedrooms across two beautifully private spaces, with a pool, gardens and the Caribbean just moments away.</p>
      <p class="hero__sub">Slow mornings in the sunshine. Long lunches beneath the terrace. Sunset drinks as the garden cools. Evenings together over dinner and a barbecue.</p>
      <div class="hero__ctas">
        <a href="/reserve" class="btn btn-gold">Reserve Your Stay</a>
        <a href="/gallery" class="btn btn-outline-light">Explore Carlton Ridge</a>
      </div>
    </div>
    <div class="wrap hero__stats">
      <p class="hero__facts">{heroFacts}</p>
    </div>
  </section>

  <!-- 2. THE EXPERIENCE -->
  <section class="section section-sand intro" id="experience">
    <div class="wrap intro__grid">
      <div class="intro__text">
        <p class="eyebrow">The experience</p>
        <h2>Your stay at Carlton Ridge</h2>
        <div class="divider"></div>
        <p class="intro__lead">Six bedrooms, expansive gardens and a private pool, with the Caribbean just moments away. One very special place to stay in Barbados.</p>
        <p>Four bedrooms in the main residence, plus a completely self-contained two-bedroom garden residence &mdash; giving everyone the freedom to be together, or have space of their own.</p>
        <p>There is a particular pleasure to having your own residence in Barbados.</p>
        <p>Breakfast when you feel like it. A few hours in the sunshine. A swim in the Caribbean Sea before lunch. Sunset drinks on the terrace. Dinner outside while the evening stretches on.</p>
        <p>Carlton Ridge gives everyone room to be together &mdash; without everyone having to do the same thing.</p>
        <p class="intro__close">This is Barbados at an unhurried pace.</p>
      </div>
      <div class="intro__image">
        <div class="hept-frame">
          <svg class="hept-frame__outline" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <polygon points="50,0 97.5,20.6 97.5,79.4 50,100 2.5,79.4 2.5,20.6" stroke="var(--gold)" stroke-width="1.5" fill="none" />
          </svg>
          <div class="hept-frame__clip">
            <img src="/images/Pool.png" alt="The heptagonal swimming pool at Carlton Ridge" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. THE PROPERTY -->
  <section class="section split">
    <div class="split__panel">
      <img src="/images/LivingRoom.jpeg" alt="Living room in the main house at Carlton Ridge" loading="lazy" decoding="async" />
      <div class="split__caption">
        <p class="eyebrow">The main residence</p>
        <h3>Space to be together</h3>
        <p>Four en suite bedrooms and open-plan living spaces, with high ceilings and ceiling fans that carry the sea breeze through &mdash; a home made to be lived in, not just photographed.</p>
        <a href="/the-villa" class="btn btn-outline-dark">Tour the Residence</a>
      </div>
    </div>
    <div class="split__panel">
      <img src="/images/CottageLivingRoom.jpeg" alt="Living room in the private garden residence at Carlton Ridge" loading="lazy" decoding="async" />
      <div class="split__caption">
        <p class="eyebrow">The garden residence</p>
        <h3>Space to be yourself</h3>
        <p>A self-contained two-bedroom retreat in the garden, with its own kitchen, living room and terrace.</p>
        <a href="/garden-residence" class="btn btn-outline-dark">Discover the Garden Residence</a>
      </div>
    </div>
  </section>

  <!-- 4. GARDEN RESIDENCE -->
  <section class="section feature">
    <div class="wrap feature__grid">
      <div class="feature__text">
        <p class="eyebrow">Two residences, one holiday</p>
        <h2>Together, with room to breathe</h2>
        <div class="divider"></div>
        <p class="feature__lead">Four bedrooms in the main house. Two more in a separate garden residence.</p>
        <p>Carlton Ridge works particularly well for families and groups travelling together.</p>
        <p>The two-bedroom garden residence has its own kitchen, living space and terrace, giving grandparents, older children, friends or staff the freedom to have their own space while remaining part of the same holiday.</p>
        <p class="feature__kicker">More than a villa</p>
        <p class="feature__close">It feels less like booking a large villa &mdash; and more like having your own private Barbados estate for the week.</p>
      </div>
      <img class="feature__img" src="/images/CottageTerrace.jpeg" alt="Terrace of the private garden residence at Carlton Ridge" loading="lazy" decoding="async" />
    </div>
  </section>

  <!-- 5. POOL / OUTDOOR LIVING -->
  <section class="section outdoor">
    <img src="/images/poolsunset.png" alt="The pool at Carlton Ridge at sunset" class="outdoor__img" loading="lazy" decoding="async" />
    <div class="outdoor__scrim"></div>
    <div class="wrap outdoor__content">
      <p class="eyebrow eyebrow--light">Life outdoors</p>
      <h2>Days are meant to be spent outside</h2>
      <p>Slow mornings in the sunshine. Sunset drinks on the terrace. Barbecue dinners beneath the Caribbean sky.</p>
    </div>
  </section>

  <!-- 6. WHAT'S INCLUDED -->
  <section class="section section-navy amenities">
    <div class="wrap">
      <p class="eyebrow">What&rsquo;s included</p>
      <h2>Everything you need for an easy week</h2>
      <div class="amenities__cols">
        <div>
          <h3>Made for living outdoors</h3>
          <ul class="amenities__list">
            {outdoorLiving.map(a => <li>{a}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. LOCATION -->
  <section class="section location-teaser">
    <img src="/images/AerialPlan.jpeg" alt="Aerial plan view of Carlton Ridge and surrounding estate" class="location-teaser__img" loading="lazy" decoding="async" />
    <div class="location-teaser__scrim"></div>
    <div class="wrap location-teaser__content">
      <p class="eyebrow eyebrow--light">The West Coast of Barbados</p>
      <h2>Everything close. Your own space to come home to.</h2>
      <p>Carlton Ridge sits on Barbados&rsquo; West Coast, close to the calm Caribbean waters that make this side of the island so special.</p>
      <p>The beach is close by, while Holetown, Speightstown, restaurants, golf and some of Barbados&rsquo; best-known beaches are all within easy reach.</p>
      <p>Close enough to enjoy everything. Far enough away to come home and switch off.</p>
      <a href="/location" class="btn btn-outline-light">Explore the Area</a>
    </div>
  </section>

  <!-- 8. GALLERY -->
  <section class="section section-sand gallery-teaser">
    <div class="wrap">
      <div class="gallery-teaser__head">
        <div>
          <p class="eyebrow">The gallery</p>
          <h2>Take a closer look</h2>
        </div>
        <a href="/gallery" class="btn btn-outline-dark">Full Gallery</a>
      </div>
      <div class="gallery-teaser__grid">
        <img src="/images/patio.png" alt="Covered patio at Carlton Ridge" loading="lazy" decoding="async" />
        <img src="/images/PoolTable.jpeg" alt="Games room with a full-size pool table at Carlton Ridge" loading="lazy" decoding="async" />
        <img src="/images/mastersuite2.png" alt="Bedroom overlooking the pool at Carlton Ridge" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- 9. CTA -->
  <section class="section cta-band">
    <div class="wrap cta-band__inner">
      <div class="cta-band__text">
        <h2>Your Barbados stay starts here</h2>
        <p>Six bedrooms. Twelve guests. Gardens, terraces and space to come together.</p>
        <p>Check available dates and start planning your stay at Carlton Ridge.</p>
      </div>
      <a href="/reserve" class="btn btn-gold">Check Availability</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; min-height: 92vh; display: flex; flex-direction: column; justify-content: flex-end; color: var(--white); overflow: hidden; }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(22,38,58,0.35) 0%, rgba(22,38,58,0.25) 40%, rgba(22,38,58,0.85) 100%); }
  .hero__content { position: relative; padding-bottom: 3rem; max-width: 760px; }
  .hero__content h1 { color: var(--white); }
  .eyebrow--light { color: var(--white); }
  .eyebrow--light::before { background: var(--duck-egg); }
  .hero__lede { font-size: 1.1rem; font-weight: 700; max-width: 560px; margin-top: 1rem; color: var(--duck-egg-pale); }
  .hero__ctas { display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }
  .hero__stats { position: relative; display: flex; gap: clamp(1.5rem, 5vw, 4rem); padding: 1.8rem 0 2.2rem; border-top: 1px solid rgba(255,255,255,0.25); margin-top: 2.5rem; }
  .stat { display: flex; flex-direction: column; }
  .stat__n { font-family: var(--font-display); font-size: 2rem; color: var(--white); }
  .stat__l { font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--white); margin-top: 0.3em; }

  .intro__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: center; }
  .intro__text p { color: var(--navy-soft); }
  .intro__image { display: flex; justify-content: center; }
  .hept-frame { position: relative; width: 420px; height: 420px; }
  .hept-frame__outline { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hept-frame__clip { position: absolute; inset: 14px; clip-path: polygon(50% 0%, 97.5% 20.6%, 97.5% 79.4%, 50% 100%, 2.5% 79.4%, 2.5% 20.6%); overflow: hidden; }
  .hept-frame__clip img { width: 100%; height: 100%; object-fit: cover; }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 0; padding: 0; }
  .split__panel { position: relative; }
  .split__panel img { width: 100%; height: 420px; object-fit: cover; }
  .split__caption { padding: 2.5rem var(--edge); background: var(--duck-egg-pale); }
  .split__caption p { color: var(--navy-soft); }

  .amenities__list { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem 3rem; max-width: 800px; }
  .amenities__list li { position: relative; padding-left: 1.6em; font-size: 0.95rem; color: var(--duck-egg-pale); }
  .amenities__list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 8px; height: 8px; border: 1px solid var(--gold); transform: rotate(45deg); }

  .hero__headline { font-weight: 700; font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 2rem); color: var(--white); margin: 0.6rem 0 0; }
  .hero__sub { font-weight: 700; max-width: 560px; margin-top: 0.8rem; color: var(--duck-egg-pale); font-size: 0.98rem; }
  .hero__facts { margin: 0; font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--white); }
  .intro__lead { font-family: var(--font-display); font-size: 1.4rem; line-height: 1.3; color: var(--navy) !important; }
  .intro__close { font-family: var(--font-display); font-size: 1.3rem; color: var(--navy); }

  .feature__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .feature__text p { color: var(--navy-soft); }
  .feature__lead { font-size: 1.1rem; color: var(--navy); }
  .feature__kicker { margin: 2rem 0 0; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold) !important; }
  .feature__close { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.3; color: var(--navy); margin: 0.6rem 0 2rem; }
  .feature__img { width: 100%; height: 520px; object-fit: cover; }

  .outdoor { position: relative; min-height: 55vh; display: flex; align-items: center; color: var(--white); }
  .outdoor__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .outdoor__scrim { position: absolute; inset: 0; background: rgba(22,38,58,0.5); }
  .outdoor__content { position: relative; max-width: 620px; }
  .outdoor__content h2 { color: var(--white); }
  .outdoor__content p { color: var(--duck-egg-pale); font-size: 1.1rem; }

  .amenities__cols { margin-top: 2.5rem; }
  .amenities__cols h3 { margin: 0; }
  .amenities__cols .amenities__list { margin-top: 1.5rem; }

  .cta-band__text p { margin: 0.6rem 0 0; color: var(--navy); }

  .gallery-teaser__head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem; }
  .gallery-teaser__grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 1.2rem; }
  .gallery-teaser__grid img { width: 100%; height: 340px; object-fit: cover; }
  .gallery-teaser__grid img:not(:first-child) { height: 340px; }

  .location-teaser { position: relative; min-height: 60vh; display: flex; align-items: center; color: var(--white); }
  .location-teaser__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .location-teaser__scrim { position: absolute; inset: 0; background: rgba(22,38,58,0.6); }
  .location-teaser__content { position: relative; max-width: 560px; }
  .location-teaser__content h2 { color: var(--white); }
  .location-teaser__content p { color: var(--duck-egg-pale); }

  .cta-band { background: var(--gold); }
  .cta-band__inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
  .cta-band h2 { margin: 0; max-width: 560px; }
  .cta-band .btn-gold { background: var(--navy); border-color: var(--navy); color: var(--white); }
  .cta-band .btn-gold:hover { background: var(--white); border-color: var(--white); color: var(--navy); }

  @media (max-width: 860px) {
    .intro__grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .hept-frame { width: 320px; height: 320px; }
    .split { grid-template-columns: 1fr; }
    .feature__grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .feature__img { height: 340px; }
    .amenities__list { grid-template-columns: 1fr; }
    .gallery-teaser__grid { grid-template-columns: 1fr; }
  }
</style>
