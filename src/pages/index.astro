---
import BaseLayout from '../layouts/BaseLayout.astro';
import Heptagon from '../components/Heptagon.astro';

const stats = [
  { n: '6', l: 'Bedrooms' },
  { n: '8', l: 'Bathrooms' },
  { n: '12', l: 'Guests' },
  { n: '6,000', l: 'Sq. Ft.' },
];

const amenities = [
  'Private heptagonal pool & wet bar',
  'Fully self-contained 2-bedroom cottage',
  'Chef\u2019s kitchen with double oven',
  'Master suite with jacuzzi & steam room',
  'Whole-property backup generator',
  'Electronic gates & alarm system',
  'Full irrigation & water softening',
  'Air conditioning throughout',
];
---
<BaseLayout title="Carlton Ridge - A Private West Coast Residence">
  <!-- HERO -->
  <section class="hero">
    <img src="/images/ArialSeaview.jpeg" alt="Aerial view of Carlton Ridge and the Barbados coastline" class="hero__img" />
    <div class="hero__scrim"></div>
    <div class="wrap hero__content">
      <p class="eyebrow eyebrow--light">Holetown &middot; St. James &middot; West Coast, Barbados</p>
      <h1>Carlton Ridge</h1>
      <p class="hero__lede">A private Barbados residence designed for gathering — six bedrooms, a self-contained cottage, and gardens that run down to a large private pool, all a short walk from the island’s calmest water.</p>
      <div class="hero__ctas">
        <a href="/enquire" class="btn btn-gold" data-open-availability>Enquire to Stay</a>
        <a href="/gallery" class="btn btn-outline-light">View Gallery</a>
      </div>
    </div>
    <div class="wrap hero__stats">
      {stats.map(s => (
        <div class="stat">
          <span class="stat__n">{s.n}</span>
          <span class="stat__l">{s.l}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- INTRO -->
  <section class="section section-sand intro">
    <div class="wrap intro__grid">
      <div class="intro__text">
        <p class="eyebrow">Welcome</p>
        <h2>A residence built for lazy mornings, pool days and sunset evenings</h2>
        <div class="divider"></div>
        <p>Set on the largest plot in Carlton View Estate, Carlton Ridge is an immaculately maintained residence of some 6,000 square feet, arranged so that every principal room opens toward the garden and pool beyond. Four bedrooms sit within the main house; a further two form a private, fully self-contained cottage with its own kitchen, living space and patio &mdash; ideal for extended family, staff, or guests who value their own front door.</p>
        <p>Inside, a chef’s kitchen with double oven and generous counter space opens onto a covered dining patio built for entertaining. Every bedroom is en suite, and the principal suite adds his-and-hers vanities, a walk-in dressing room and a jacuzzi bath that converts to a steam room.</p>
      </div>
      <div class="intro__image">
        <div class="hept-frame">
          <Heptagon size={420} stroke="var(--gold)" strokeWidth={1.5} class="hept-frame__outline" />
          <div class="hept-frame__clip">
            <img src="/images/Pool.jpeg" alt="The heptagonal swimming pool at Carlton Ridge" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN HOUSE / COTTAGE -->
  <section class="section split">
    <div class="split__panel">
      <img src="/images/LivingRoom.jpeg" alt="Living room in the main house at Carlton Ridge" />
      <div class="split__caption">
        <p class="eyebrow">The Main House</p>
        <h3>Four bedrooms, one generous heart</h3>
        <p>High ceilings and ceiling fans carry the sea breeze through open-plan living spaces, all finished with the quiet restraint of a home built to be lived in, not just photographed.</p>
        <a href="/the-villa" class="btn btn-outline-dark">Tour the Villa</a>
      </div>
    </div>
    <div class="split__panel">
      <img src="/images/CottageLivingRoom.jpeg" alt="Living room in the self-contained cottage at Carlton Ridge" />
      <div class="split__caption">
        <p class="eyebrow">The Cottage</p>
        <h3>A private two-bedroom retreat</h3>
        <p>Its own kitchen, living room and terrace make the cottage a self-sufficient annex &mdash; perfect for multigenerational stays without anyone underfoot.</p>
        <a href="/the-villa#cottage" class="btn btn-outline-dark">See the Cottage</a>
      </div>
    </div>
  </section>

  <!-- AMENITIES -->
  <section class="section section-navy amenities">
    <div class="wrap">
      <p class="eyebrow">In Residence</p>
      <h2>Every comfort, quietly handled</h2>
      <ul class="amenities__list">
        {amenities.map(a => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <!-- GALLERY TEASER -->
  <section class="section section-sand gallery-teaser">
    <div class="wrap">
      <div class="gallery-teaser__head">
        <div>
          <p class="eyebrow">A Closer Look</p>
          <h2>Rooms, gardens &amp; the pool terrace</h2>
        </div>
        <a href="/gallery" class="btn btn-outline-dark">Full Gallery</a>
      </div>
      <div class="gallery-teaser__grid">
        <img src="/images/Patio.jpeg" alt="Covered patio at Carlton Ridge" />
        <img src="/images/MasterBathroom.jpeg" alt="Master bathroom at Carlton Ridge" />
        <img src="/images/BedroomByPool.jpeg" alt="Bedroom overlooking the pool at Carlton Ridge" />
      </div>
    </div>
  </section>

  <!-- LOCATION TEASER -->
  <section class="section location-teaser">
    <img src="/images/AerialPlan.jpeg" alt="Aerial plan view of Carlton Ridge and surrounding estate" class="location-teaser__img" />
    <div class="location-teaser__scrim"></div>
    <div class="wrap location-teaser__content">
      <p class="eyebrow eyebrow--light">Where You Are</p>
      <h2>Minutes from Holetown and Speightstown</h2>
      <p>Near-beach, on the West Coast, within easy reach of golf, dining and the calm waters Barbados is known for.</p>
      <a href="/location" class="btn btn-outline-light">Explore the Area</a>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="section cta-band">
    <div class="wrap cta-band__inner">
      <h2>Ready to make Carlton Ridge yours for the week?</h2>
      <a href="/enquire" class="btn btn-gold" data-open-availability>Check Availability</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; min-height: 92vh; display: flex; flex-direction: column; justify-content: flex-end; color: var(--white); overflow: hidden; }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(22,38,58,0.35) 0%, rgba(22,38,58,0.25) 40%, rgba(22,38,58,0.85) 100%); }
  .hero__content { position: relative; padding-bottom: 3rem; max-width: 760px; }
  .eyebrow--light { color: var(--white); }
  .eyebrow--light::before { background: var(--duck-egg); }
  .hero__lede { font-size: 1.1rem; font-weight: 700; max-width: 560px; margin-top: 1rem; color: var(--duck-egg-pale); }
  .hero__ctas { display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }
  .hero__stats { position: relative; display: flex; gap: clamp(1.5rem, 5vw, 4rem); padding: 1.8rem 0 2.2rem; border-top: 1px solid rgba(255,255,255,0.25); margin-top: 2.5rem; }
  .stat { display: flex; flex-direction: column; }
  .stat__n { font-family: var(--font-display); font-size: 2rem; color: var(--white); }
  .stat__l { font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--white); margin-top: 0.3em; }

  .intro__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: center; }
  .intro__text p { color: var(--navy-soft); }
  .intro__image { display: flex; justify-content: center; }
  .hept-frame { position: relative; width: 420px; height: 420px; }
  .hept-frame__outline { position: absolute; inset: 0; }
  .hept-frame__clip { position: absolute; inset: 14px; clip-path: polygon(50% 0%, 97.5% 20.6%, 97.5% 79.4%, 50% 100%, 2.5% 79.4%, 2.5% 20.6%); overflow: hidden; }
  .hept-frame__clip img { width: 100%; height: 100%; object-fit: cover; }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 0; padding: 0; }
  .split__panel { position: relative; }
  .split__panel img { width: 100%; height: 420px; object-fit: cover; }
  .split__caption { padding: 2.5rem var(--edge); background: var(--duck-egg-pale); }
  .split__caption p { color: var(--navy-soft); }

  .amenities__list { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem 3rem; max-width: 800px; }
  .amenities__list li { position: relative; padding-left: 1.6em; font-size: 0.95rem; color: var(--duck-egg-pale); }
  .amenities__list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 8px; height: 8px; border: 1px solid var(--gold); transform: rotate(45deg); }

  .gallery-teaser__head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem; }
  .gallery-teaser__grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 1.2rem; }
  .gallery-teaser__grid img { width: 100%; height: 340px; object-fit: cover; }
  .gallery-teaser__grid img:not(:first-child) { height: 340px; }

  .location-teaser { position: relative; min-height: 60vh; display: flex; align-items: center; color: var(--white); }
  .location-teaser__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .location-teaser__scrim { position: absolute; inset: 0; background: rgba(22,38,58,0.6); }
  .location-teaser__content { position: relative; max-width: 560px; }
  .location-teaser__content p { color: var(--duck-egg-pale); }

  .cta-band { background: var(--gold); }
  .cta-band__inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
  .cta-band h2 { margin: 0; max-width: 560px; }
  .cta-band .btn-gold { background: var(--navy); border-color: var(--navy); color: var(--white); }
  .cta-band .btn-gold:hover { background: var(--white); border-color: var(--white); color: var(--navy); }

  @media (max-width: 860px) {
    .intro__grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .hept-frame { width: 320px; height: 320px; }
    .split { grid-template-columns: 1fr; }
    .amenities__list { grid-template-columns: 1fr; }
    .gallery-teaser__grid { grid-template-columns: 1fr; }
  }
</style>
