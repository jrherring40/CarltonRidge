---
import BaseLayout from '../layouts/BaseLayout.astro';

// Room names follow the Villa and Garden Residence pages. `alt` describes what is visible;
// `caption` + `where` tell guests what the photo is and which part of the estate it belongs to.
const sections = [
  {
    id: 'grounds',
    title: 'The grounds & pool',
    photos: [
      { src: '/images/ArialSeaview.jpeg', where: 'Grounds', caption: 'Main residence and sea view', alt: 'Drone view over palm trees to a single-storey house with a dark hipped roof, a curving paved driveway and the blue sea on the horizon' },
      { src: '/images/AerialPlan.jpeg', where: 'Grounds', caption: 'Main residence, pool and gardens', alt: 'Top-down aerial view of the grey-roofed house wrapped around a courtyard, with the pool and sun loungers at the top and a separate wing to the right' },
      { src: '/images/Pool.png', where: 'Grounds', caption: 'Pool and sun terrace', alt: 'Turquoise pool with a stainless-steel rail, wicker sun loungers on a pale stone deck, a gazebo bar at left and the house behind palms' },
      { src: '/images/patio.png', where: 'Main residence', caption: 'Covered dining terrace', alt: 'Shaded stone terrace with white-cushioned wicker armchairs, a long dining table and arched openings looking onto the pool' },
      { src: '/images/poolsunset.png', where: 'Grounds', caption: 'Pool and gazebo at sunset', alt: 'Pool, loungers and a small gazebo bar under a pink and orange sunset sky with palm silhouettes' },
      { src: '/images/poolpatiosunset.png', where: 'Grounds', caption: 'Terrace and pool at dusk', alt: 'Arched patio glowing with warm lights and set with a dining table, reflected in the pool at dusk' },
    ],
  },
  {
    id: 'main-residence',
    title: 'Main residence',
    photos: [
      { src: '/images/LivingRoom.jpeg', where: 'Main residence', caption: 'Main residence living room', alt: 'High-ceilinged living room with a large sectional sofa, wall-mounted TV and curtained openings to a terrace' },
      { src: '/images/PoolTable.jpeg', where: 'Main residence', caption: 'Games room and pool table', alt: 'Pool table racked up in the middle of an open room, with the kitchen and breakfast bar to the left and sofas to the right' },
      { src: '/images/Kitchen.jpeg', where: 'Main residence', caption: 'Kitchen and breakfast island', alt: 'White kitchen with granite counters, an island with bar stools, a double oven and a range hood' },
    ],
  },
  {
    id: 'bedrooms',
    title: 'Bedrooms & bathroom',
    photos: [
      { src: '/images/mastersuite2.png', where: 'Main residence', caption: 'Master suite and veranda', alt: 'Cream four-poster bed with blue accents, a sitting chair and open doors leading to a veranda and the pool' },
      { src: '/images/MasterBathroom.jpeg', where: 'Main residence', caption: 'Master bathroom', alt: 'Stone-tiled bathroom with a raised oval bath, a glass-enclosed shower with a bench and double vanities' },
      { src: '/images/masterguestpool.png', where: 'Main residence', caption: 'Poolside guest suite', alt: 'Dark wood four-poster bed beside louvred wardrobes, with open double doors to a garden patio' },
      { src: '/images/blushpinkroom.png', where: 'Main residence', caption: 'Guest suite with private garden patio', alt: 'Bedroom with a white-washed wicker bed, pink quilted bedding, a bedside lamp and a tall window with linen curtains looking onto greenery' },
      { src: '/images/villaguestroom3.png', where: 'Main residence', caption: 'Guest suite with access to gardens and private patio', alt: 'Bedroom with a dark wood bed, white linens, a ceiling fan and tall French doors with curtains' },
    ],
  },
  {
    id: 'garden-residence',
    title: 'Garden residence',
    photos: [
      { src: '/images/gardenresidenceleftbedroom.png', where: 'Garden residence', caption: 'Garden residence, Suite One', alt: 'Bedroom with a white bed, vaulted beamed ceiling and three tall windows onto green foliage' },
      { src: '/images/gardenresidencerightbedroom.png', where: 'Garden residence', caption: 'Garden residence, Suite Two', alt: 'Bedroom with a white bed, beamed ceiling, an armchair and windows looking toward the pool' },
      { src: '/images/CottageLivingRoom.jpeg', where: 'Garden residence', caption: 'Living room and kitchen', alt: 'Open living room with striped sofas, wicker armchairs and a coffee table, with a wooden kitchen along the left wall' },
      { src: '/images/CottageTerrace.jpeg', where: 'Garden residence', caption: 'Private terrace and garden path', alt: 'Covered terrace with white columns and blue chairs beside a lawn with a stepping-stone path through tropical plants' },
    ],
  },
];

let n = 0;
const numbered = sections.map(sec => ({ ...sec, photos: sec.photos.map(p => ({ ...p, index: n++ })) }));
const total = n;
---
<BaseLayout title="Gallery" description="Photographs of Carlton Ridge: the grounds and pool, main residence, bedrooms and the garden residence.">
  <section class="page-hero">
    <div class="wrap page-hero__content">
      <p class="eyebrow">In pictures</p>
      <h1>A glimpse of Carlton Ridge</h1>
      <p>From the gardens and pool to the light-filled interiors and private terraces, explore Carlton Ridge in pictures.</p>
      <nav class="gallery-jump" aria-label="Gallery sections">
        {numbered.map(sec => <a href={`#${sec.id}`}>{sec.title}</a>)}
      </nav>
    </div>
  </section>

  {numbered.map((sec, si) => (
    <section class={`section gallery-section ${si % 2 === 0 ? 'section-sand' : 'section-duckegg'}`} id={sec.id} aria-labelledby={`${sec.id}-title`}>
      <div class="wrap">
        <h2 id={`${sec.id}-title`}>{sec.title}</h2>
        <div class="divider"></div>
        {sec.intro && <p class="gallery-section__intro">{sec.intro}</p>}
        <ul class="gallery-grid">
          {sec.photos.map(img => (
            <li class="gallery-grid__cell">
              <button type="button" class="gallery-item" data-index={img.index} data-caption={img.caption} aria-label={`View larger: ${img.caption}`} aria-haspopup="dialog">
                <img src={img.src} alt={img.alt} loading="lazy" />
              </button>
              <p class="gallery-caption">{img.caption}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section cta-band gallery-cta">
    <div class="wrap cta-band__inner">
      <div class="cta-band__text">
        <h2>Like what you see?</h2>
        <p>Check available dates and rates for Carlton Ridge.</p>
      </div>
      <a href="/reserve" class="btn btn-gold">Check Availability</a>
    </div>
  </section>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" aria-hidden="true">
    <button type="button" class="lightbox__close" id="lightboxClose" aria-label="Close viewer"><span aria-hidden="true">&times;</span><span class="lightbox__close-text" aria-hidden="true">Close</span></button>
    <figure class="lightbox__figure">
      <img class="lightbox__img" id="lightboxImg" src="" alt="" />
      <figcaption class="lightbox__caption">
        <span id="lightboxCaption"></span>
        <span class="lightbox__count" id="lightboxCount" aria-live="polite"></span>
      </figcaption>
    </figure>
    <button type="button" class="lightbox__nav lightbox__nav--prev" id="lightboxPrev" aria-label="Previous photo">&#8249;</button>
    <button type="button" class="lightbox__nav lightbox__nav--next" id="lightboxNext" aria-label="Next photo">&#8250;</button>
  </div>
</BaseLayout>

<style>
  /* The header's off-canvas mobile menu widens the mobile layout viewport; clip it so the fixed viewer fits the screen. */
  :global(html), :global(body) { overflow-x: hidden; }

  .page-hero { background: var(--navy); padding: 6rem 0 3rem; color: var(--white); }
  .page-hero__content h1 { color: var(--white); }
  .page-hero__content > p:not(.eyebrow) { color: var(--duck-egg-pale); margin-top: 0.5rem; }
  .gallery-jump { display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; margin-top: 1.6rem; }
  .gallery-jump a { color: var(--white); font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; border-bottom: 1px solid var(--gold); padding: 0.4rem 0; }
  .gallery-jump a:hover { color: var(--duck-egg); }

  .gallery-section { scroll-margin-top: 4rem; }
  .gallery-section__intro { color: var(--navy-soft); max-width: 640px; margin-bottom: 0; }

  .gallery-grid { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem 1.2rem; }
  .gallery-item { display: block; width: 100%; padding: 0; border: none; background: none; cursor: pointer; }
  .gallery-item img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; transition: opacity 0.3s ease; }
  .gallery-item:hover img { opacity: 0.85; }
  .gallery-item:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .gallery-caption { margin: 0.6rem 0 0; font-size: 0.92rem; color: var(--navy); line-height: 1.4; }

  .gallery-cta { background: var(--gold); }
  .gallery-cta .cta-band__inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
  .gallery-cta h2 { margin: 0; }
  .gallery-cta p { margin: 0.3rem 0 0; }
  .gallery-cta .btn-gold { background: var(--navy); border-color: var(--navy); color: var(--white); }
  .gallery-cta .btn-gold:hover { background: var(--white); border-color: var(--white); color: var(--navy); }

  .lightbox {
    position: fixed; inset: 0; background: rgba(22,38,58,0.96);
    display: none; flex-direction: column; align-items: center; justify-content: center;
    z-index: 200; padding: 4.5rem 5rem 2rem; touch-action: pan-y;
  }
  .lightbox.is-open { display: flex; }
  .lightbox__figure { margin: 0; display: flex; flex-direction: column; align-items: center; max-width: 100%; }
  .lightbox__img { max-width: 100%; max-height: calc(100vh - 11rem); max-height: calc(100dvh - 11rem); object-fit: contain; }
  .lightbox__caption { color: var(--white); margin-top: 1rem; text-align: center; font-size: 0.95rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .lightbox__count { color: var(--duck-egg); font-size: 0.85rem; letter-spacing: 0.1em; }
  .lightbox__close, .lightbox__nav {
    position: absolute; background: rgba(22,38,58,0.7); border: 1px solid rgba(255,255,255,0.6);
    color: var(--white); cursor: pointer; display: flex; align-items: center; justify-content: center;
  }
  .lightbox__close { top: 1rem; right: 1rem; min-width: 48px; height: 48px; padding: 0 0.9rem; gap: 0.5rem; border-radius: 24px; font-size: 1.8rem; line-height: 1; }
  .lightbox__close-text { font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .lightbox__nav { top: 50%; transform: translateY(-50%); width: 52px; height: 52px; border-radius: 50%; font-size: 2rem; line-height: 1; padding-bottom: 0.2rem; }
  .lightbox__nav--prev { left: 1rem; }
  .lightbox__nav--next { right: 1rem; }
  .lightbox__close:hover, .lightbox__nav:hover { background: var(--white); color: var(--navy); }
  .lightbox__close:focus-visible, .lightbox__nav:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }

  @media (max-width: 900px) { .gallery-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 720px) {
    .gallery-grid { grid-template-columns: 1fr; }
    .lightbox { padding: 4.5rem 0.75rem 5.5rem; }
    .lightbox__img { max-height: calc(100vh - 13rem); max-height: calc(100dvh - 13rem); }
    .lightbox__nav { top: auto; bottom: 1rem; transform: none; width: 56px; height: 56px; }
    .lightbox__nav--prev { left: 1rem; }
    .lightbox__nav--next { right: 1rem; }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-item'));
  const lightbox = document.getElementById('lightbox')!;
  const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
  const caption = document.getElementById('lightboxCaption')!;
  const count = document.getElementById('lightboxCount')!;
  const closeBtn = document.getElementById('lightboxClose') as HTMLButtonElement;
  const prevBtn = document.getElementById('lightboxPrev') as HTMLButtonElement;
  const nextBtn = document.getElementById('lightboxNext') as HTMLButtonElement;
  const controls = [closeBtn, prevBtn, nextBtn];
  let current = 0;
  let opener: HTMLElement | null = null;

  function show(i: number) {
    current = (i + items.length) % items.length;
    const btn = items[current];
    const img = btn.querySelector('img') as HTMLImageElement;
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt;
    caption.textContent = btn.dataset.caption ?? '';
    count.textContent = `${current + 1} of ${items.length}`;
  }
  function open(i: number, trigger: HTMLElement) {
    opener = trigger;
    show(i);
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }
  function close() {
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    opener?.focus();
  }
  const isOpen = () => lightbox.classList.contains('is-open');

  items.forEach((btn, i) => btn.addEventListener('click', () => open(i, btn)));
  closeBtn.addEventListener('click', close);
  prevBtn.addEventListener('click', () => show(current - 1));
  nextBtn.addEventListener('click', () => show(current + 1));
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });

  document.addEventListener('keydown', (e) => {
    if (!isOpen()) return;
    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
    else if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
    else if (e.key === 'Tab') {
      // Keep focus inside the viewer.
      const first = controls[0], last = controls[controls.length - 1];
      const active = document.activeElement as HTMLElement;
      if (!controls.includes(active as HTMLButtonElement)) { e.preventDefault(); first.focus(); }
      else if (e.shiftKey && active === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && active === last) { e.preventDefault(); first.focus(); }
    }
  });

  // Touch swipe: left = next, right = previous.
  let startX = 0, startY = 0;
  lightbox.addEventListener('touchstart', (e) => {
    startX = e.changedTouches[0].clientX; startY = e.changedTouches[0].clientY;
  }, { passive: true });
  lightbox.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    const dy = e.changedTouches[0].clientY - startY;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
  }, { passive: true });
</script>
