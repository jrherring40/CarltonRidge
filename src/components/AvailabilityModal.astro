---
const AVAILABILITY_URL = 'https://www.island-villas.com/properties/21809035/lettings/carlton-ridge/CARLTONRIDGE#/availability';
---
<div class="availability-modal" id="availabilityModal" aria-hidden="true">
  <div class="availability-modal__backdrop" id="availabilityModalBackdrop"></div>
  <div class="availability-modal__panel" role="dialog" aria-modal="true" aria-labelledby="availabilityModalTitle">
    <div class="availability-modal__head">
      <div>
        <p class="eyebrow">Bookings &amp; Availability</p>
        <h3 id="availabilityModalTitle">Check Availability</h3>
      </div>
      <button class="availability-modal__close" id="availabilityModalClose" aria-label="Close">&times;</button>
    </div>
    <p class="availability-modal__note">Live calendar from Island Villas. If it doesn&rsquo;t load below, use the button to open it directly.</p>
    <div class="availability-modal__frame-wrap">
      <iframe
        class="availability-modal__frame"
        src={AVAILABILITY_URL}
        title="Carlton Ridge availability calendar"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <a href={AVAILABILITY_URL} class="btn btn-gold" target="_blank" rel="noreferrer">Open Availability via Island Villas</a>
  </div>
</div>

<style>
  .availability-modal {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .availability-modal.is-open { display: flex; }
  .availability-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(22, 38, 58, 0.75);
  }
  .availability-modal__panel {
    position: relative;
    background: var(--white);
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .availability-modal__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .availability-modal__note { color: var(--navy-soft); font-size: 0.88rem; margin: 0; }
  .availability-modal__frame-wrap {
    flex: 1;
    min-height: 300px;
    border: 1px solid var(--duck-egg-dark);
    overflow: hidden;
  }
  .availability-modal__frame {
    width: 100%;
    height: 100%;
    min-height: 500px;
    border: 0;
    display: block;
  }
  .availability-modal__panel .btn { align-self: center; }
  .availability-modal__close {
    background: none;
    border: none;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    color: var(--navy-soft);
    flex-shrink: 0;
  }

  @media (max-width: 720px) {
    .availability-modal__panel { padding: 1.4rem; max-height: 95vh; }
    .availability-modal__frame { min-height: 380px; }
  }
</style>

<script>
  function initAvailabilityModal() {
    const modal = document.getElementById('availabilityModal');
    const backdrop = document.getElementById('availabilityModalBackdrop');
    const closeBtn = document.getElementById('availabilityModalClose');
    if (!modal) return;

    function openModal(e: Event) {
      e.preventDefault();
      modal!.classList.add('is-open');
      modal!.setAttribute('aria-hidden', 'false');
    }
    function closeModal() {
      modal!.classList.remove('is-open');
      modal!.setAttribute('aria-hidden', 'true');
    }

    document.querySelectorAll('[data-open-availability]').forEach((el) => {
      el.addEventListener('click', openModal);
    });
    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal!.classList.contains('is-open')) closeModal();
    });
  }

  document.addEventListener('DOMContentLoaded', initAvailabilityModal);
</script>
