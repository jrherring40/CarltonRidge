---
const BOOKING_URL = 'https://www.island-villas.com/properties/21809035/lettings/carlton-ridge/CARLTONRIDGE#/';

const links = [
  { href: '/', label: 'Home' },
  { href: '/the-villa', label: 'The Residence' },
  { href: '/garden-residence', label: 'The Garden Residence' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/location', label: 'Location' },
  { href: '/reserve', label: 'Reserve' },
  { href: '/reviews', label: 'Reviews' },
  { href: '/faq', label: 'FAQ' },
];
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand">
      <span class="brand__name">Carlton Ridge</span>
      <span class="brand__sub">Holetown &middot; Barbados</span>
    </a>
    <div class="header-actions">
      <nav class="nav" aria-label="Primary">
        <button class="nav__toggle" id="navToggle" aria-expanded="false" aria-controls="navList" aria-label="Open menu">
          <span></span><span></span><span></span>
        </button>
        <ul class="nav__list" id="navList">
          {links.map(l => (
            <li>
              <a href={l.href} class={current === l.href ? 'is-active' : ''}>{l.label}</a>
            </li>
          ))}
        </ul>
        <div class="nav__backdrop" id="navBackdrop"></div>
      </nav>
      <a href={BOOKING_URL} class="btn btn-gold header-cta" target="_blank" rel="noreferrer">Reserve Your Stay</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    padding: 1.4rem 0;
    background: var(--navy);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand { display: flex; flex-direction: column; line-height: 1; color: var(--white); flex-shrink: 0; }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .brand__sub {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--duck-egg);
    margin-top: 0.35em;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav__list {
    display: flex;
    gap: 1.7rem;
    list-style: none;
    margin: 0; padding: 0;
  }
  .nav__list a {
    color: var(--white);
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, opacity 0.3s ease;
    white-space: nowrap;
  }
  .nav__list a:hover, .nav__list a.is-active {
    border-color: var(--gold);
  }
  .nav__toggle {
    display: none;
    background: none; border: none; cursor: pointer;
    flex-direction: column; gap: 5px; padding: 0.4rem;
  }
  .nav__toggle span {
    width: 24px; height: 1px; background: var(--white); display: block;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  /* Morph the hamburger into an X while the menu is open */
  .nav__toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav__toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav__toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  .nav__backdrop { display: none; }

  /* Header CTA — the global .btn-gold hover goes navy, which vanishes on the navy header */
  .header-cta {
    padding: 0.75em 1.5em;
    font-size: 0.74rem;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .header-cta:hover {
    background: transparent;
    border-color: var(--gold);
    color: var(--gold-light);
  }

  /* Tighten the nav between tablet and wide desktop so everything fits on one line */
  @media (min-width: 981px) and (max-width: 1240px) {
    .header-actions { gap: 1.4rem; }
    .nav__list { gap: 1.1rem; }
    .nav__list a { font-size: 0.7rem; letter-spacing: 0.1em; }
  }

  @media (max-width: 980px) {
    .header-actions { gap: 1rem; }
    .header-cta { order: -1; }
    /* Keep the toggle above the slide-out panel so it can close the menu */
    .nav__toggle { display: flex; position: relative; z-index: 3; }
    .nav__backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease;
      z-index: 1;
    }
    .nav__backdrop.is-open { opacity: 1; pointer-events: auto; }
    .nav__list {
      position: fixed;
      inset: 0 0 0 30%;
      background: var(--navy);
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      padding: 2rem 2.5rem;
      gap: 1.6rem;
      transform: translateX(100%);
      visibility: hidden;
      transition: transform 0.4s ease, visibility 0s linear 0.4s;
      z-index: 2;
    }
    .nav__list.is-open { transform: translateX(0); visibility: visible; transition-delay: 0s; }
  }

  @media (max-width: 420px) {
    .brand__name { font-size: 1.1rem; }
    .header-cta { padding: 0.65em 0.8em; font-size: 0.6rem; letter-spacing: 0.06em; }
    .brand__sub { font-size: 0.5rem; letter-spacing: 0.14em; }
    .site-header__inner { gap: 0.75rem; }
    .header-actions { gap: 0.5rem; }
    .nav__toggle { padding: 0.4rem 0 0.4rem 0.4rem; }
    .nav__toggle span { width: 22px; }
  }

  @media (max-width: 360px) {
    .brand__name { font-size: 1.05rem; }
    .brand__sub { display: none; }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const list = document.getElementById('navList');
  const backdrop = document.getElementById('navBackdrop');

  const setOpen = (open: boolean) => {
    list?.classList.toggle('is-open', open);
    backdrop?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => setOpen(!list?.classList.contains('is-open')));
  backdrop?.addEventListener('click', () => setOpen(false));
  list?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') setOpen(false); });
  window.matchMedia('(min-width: 981px)').addEventListener('change', e => { if (e.matches) setOpen(false); });
</script>
