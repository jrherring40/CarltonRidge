---
const links = [
  { href: '/', label: 'Home' },
  { href: '/the-villa', label: 'The Villa' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/location', label: 'Location' },
  { href: '/enquire', label: 'Enquire' },
];
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand">
      <span class="brand__name">Carlton Ridge</span>
      <span class="brand__sub">Holetown &middot; Barbados</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <button class="nav__toggle" id="navToggle" aria-expanded="false" aria-controls="navList">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav__list" id="navList">
        {links.map(l => (
          <li>
            <a href={l.href} class={current === l.href ? 'is-active' : ''}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    padding: 1.4rem 0;
    background: var(--navy);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand { display: flex; flex-direction: column; line-height: 1; color: var(--white); }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }
  .brand__sub {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--duck-egg);
    margin-top: 0.35em;
  }
  .nav__list {
    display: flex;
    gap: 2.4rem;
    list-style: none;
    margin: 0; padding: 0;
  }
  .nav__list a {
    color: var(--white);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, opacity 0.3s ease;
  }
  .nav__list a:hover, .nav__list a.is-active {
    border-color: var(--gold);
  }
  .nav__toggle {
    display: none;
    background: none; border: none; cursor: pointer;
    flex-direction: column; gap: 5px; padding: 0.4rem;
  }
  .nav__toggle span {
    width: 24px; height: 1px; background: var(--white); display: block;
  }

  @media (max-width: 860px) {
    .nav__toggle { display: flex; }
    .nav__list {
      position: fixed;
      inset: 0 0 0 30%;
      background: var(--navy);
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      padding: 2rem 2.5rem;
      gap: 1.6rem;
      transform: translateX(100%);
      transition: transform 0.4s ease;
    }
    .nav__list.is-open { transform: translateX(0); }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const list = document.getElementById('navList');
  toggle?.addEventListener('click', () => {
    const open = list?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
</script>
