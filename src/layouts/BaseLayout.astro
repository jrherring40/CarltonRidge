---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AvailabilityModal from '../components/AvailabilityModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}
const {
  title,
  description = "Carlton Ridge — a six-bedroom luxury villa on Barbados's West Coast, Holetown, St. James.",
  image = '/images/ArialSeaview.jpeg',
  imageAlt = "Aerial view of Carlton Ridge villa and its heptagonal pool, Holetown, Barbados.",
} = Astro.props;

const pageTitle = title.includes('Carlton Ridge') ? title : `${title} \u00b7 Carlton Ridge`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content="Carlton Ridge" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LodgingBusiness',
      name: 'Carlton Ridge',
      description: "Carlton Ridge — a six-bedroom luxury villa on Barbados's West Coast, Holetown, St. James.",
      url: 'https://www.carltonridgevilla.com',
      image: new URL('/images/ArialSeaview.jpeg', Astro.site).toString(),
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Carlton View Estate',
        addressLocality: 'Holetown',
        addressRegion: 'St. James',
        addressCountry: 'BB',
      },
      numberOfRooms: 6,
      amenityFeature: [
        { '@type': 'LocationFeatureSpecification', name: 'Private Pool', value: true },
        { '@type': 'LocationFeatureSpecification', name: 'Air Conditioning', value: true },
        { '@type': 'LocationFeatureSpecification', name: 'Self-Contained Cottage', value: true },
      ],
    })} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <AvailabilityModal />
  </body>
</html>
